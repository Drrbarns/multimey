# Copy to .env.local and fill in values. Do not commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Moolre Payment
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=
# Optional: secret Moolre sends in payment callback for verification (get from Moolre dashboard)
MOOLRE_CALLBACK_SECRET=

# Moolre SMS (optional)
MOOLRE_SMS_API_KEY=
# Or use MOOLRE_API_KEY for SMS if same as payment

# App
NEXT_PUBLIC_APP_URL=https://www.multimeysupplies.com
NEXT_PUBLIC_SITE_NAME=MultiMey Supplies
